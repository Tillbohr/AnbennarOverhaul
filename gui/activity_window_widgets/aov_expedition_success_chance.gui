vbox = {
	name = "aov_expedition_success_chance"
	margin = { 16 0 }

	datacontext = "[ActivityWindow.GetActivity]"

	# One row: the text sits on the bar. A label above the bar made the summary row taller than the intent row, and
	# its background then covered the conclusion's Finish button.
	progressbar_standard = {
		layoutpolicy_horizontal = expanding
		size = { 300 30 }
		value = "[Activity.MakeScope.Var( 'aov_expedition_success_chance' ).GetValue]"
		max = 100
		min = 0

		using = Progressbar_Changed_Animation

		tooltip = "aov_expedition_success_bar_tt"

		marker = {
			name = "current_value"
			widget = {
				icon = {
					size = { 25 25 }
					position = { -20 2 }
					texture = "gfx/interface/progressbars/progressbar_center_glow.dds"
					color = { 0.80 0.90 1 0.9 }
				}
			}
		}

		text_single = {
			parentanchor = center
			text = "aov_expedition_success_bar"
			default_format = "#high"
			align = nobaseline
			using = Font_Size_Medium
		}
	}
}
