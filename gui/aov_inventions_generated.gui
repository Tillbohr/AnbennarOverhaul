	# Hover tooltip of an invention's box and Technomancer proposal
	type aov_invention_arcane_battery_capital_complex_tooltip = object_tooltip_pop_out {
		blockoverride "title_text" {
			text = "aov_invention_arcane_battery_capital_complex"
			default_format = "#T"
		}

		blockoverride "subtitle_text" {
			text = "aov_invention_arcane_battery_capital_complex_subtitle"
		}

		blockoverride "concept_link" {
			visible = no
		}

		blockoverride "main_description" {
			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8

				cooltip_paragraph = {
					text = "aov_invention_arcane_battery_capital_complex_desc"
				}
				cooltip_paragraph = {
					text = "[GetScriptedGui('aov_inv_arcane_battery_capital_complex_effects_sgui').BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				}
				cooltip_paragraph = {
					visible = "[Not( GetScriptedGui('aov_inv_arcane_battery_capital_complex_unlocked_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
					text = "AOV_INV_LOCKED_TIER_1_TT"
				}
				cooltip_paragraph = {
					visible = "[GetScriptedGui('aov_inv_arcane_battery_capital_complex_undiscovered_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					text = "AOV_INV_UNDISCOVERED_TT"
				}
				cooltip_paragraph = {
					visible = "[And( GetScriptedGui('aov_inv_arcane_battery_capital_complex_activate_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), GetScriptedGui('aov_inv_arcane_battery_capital_complex_activate_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
					text = "AOV_INV_CLICK_ACTIVATE"
				}
				cooltip_paragraph = {
					visible = "[And( GetScriptedGui('aov_inv_arcane_battery_capital_complex_activate_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), Not( GetScriptedGui('aov_inv_arcane_battery_capital_complex_activate_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
					text = "AOV_INV_NO_FREE_SLOT"
				}
				cooltip_paragraph = {
					visible = "[GetScriptedGui('aov_inv_arcane_battery_capital_complex_deactivate_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					text = "AOV_INV_CLICK_DEACTIVATE"
				}
			}
		}
	}

