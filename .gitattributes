# Large binary art goes through Git LFS (same as the base Anbennar repo)
*.tga filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.dds binary
# Keep mod script/localization/GUI bytes exactly as written (UTF-8 BOM + LF; generated hud.gui keeps vanilla CRLF)
*.txt -text
*.yml -text
*.mod -text
*.gui -text
