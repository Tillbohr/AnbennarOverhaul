# Large binary art goes through Git LFS (same as the base Anbennar repo)
*.tga filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
gfx/map/**/*.dds filter=lfs diff=lfs merge=lfs -text
*.mesh filter=lfs diff=lfs merge=lfs -text
map_data/heightmap.png filter=lfs diff=lfs merge=lfs -text
map_data/packed_heightmap.png filter=lfs diff=lfs merge=lfs -text
map_data/indirection_heightmap.png filter=lfs diff=lfs merge=lfs -text
gfx/models/**/*.dds filter=lfs diff=lfs merge=lfs -text
gfx/portraits/**/*.dds filter=lfs diff=lfs merge=lfs -text
gfx/interface/illustrations/character_view/*.dds filter=lfs diff=lfs merge=lfs -text
gfx/interface/illustrations/event_scenes/*.dds filter=lfs diff=lfs merge=lfs -text
*.dds binary
# Keep mod script/localization/GUI bytes exactly as written (UTF-8 BOM + LF; generated hud.gui keeps vanilla CRLF)
*.txt -text
*.yml -text
*.mod -text
*.gui -text
