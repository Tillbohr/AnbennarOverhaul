# Anbennar Overhaul: Lichdom's skeleton portrait, imported once from Godherja: The Dying World (Workshop 2326030123;
# its art comes from Elder Kings). Names prefixed aov_; edit by hand.

############ HEAD ########################

pdxmesh = {
	name = "aov_male_skeleton_head_mesh"
	file = "male_skeleton_head.mesh"

	meshsettings = {
		name = "skeleton_head"
		index = 0
		texture_diffuse = "skeleton_head_diffuse.dds"
		texture_normal = "skeleton_head_normal.dds"
		texture_specular = "skeleton_head_properties.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	meshsettings = {
		name = "skeleton_neck"
		index = 0
		texture_diffuse = "skeleton_body_diffuse.dds"
		texture_normal = "skeleton_body_normal.dds"
		texture_specular = "skeleton_body_properties.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
}

entity = {
	name = "aov_male_skeleton_head_entity"
	pdxmesh = "aov_male_skeleton_head_mesh"
}

