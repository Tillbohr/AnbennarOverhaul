	type aov_magic_school_divination = vbox {
		layoutpolicy_horizontal = expanding
		spacing = 6

		hbox = {
			layoutpolicy_horizontal = expanding
			margin = { 6 4 }
			spacing = 10

			icon = {
				size = { 48 48 }
				texture = "gfx/interface/icons/aov_magic/school_divination.dds"
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 4

				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 6

					text_single = {
						text = "AOV_SCHOOL_DIVINATION"
						using = Font_Type_Flavor
						using = Font_Size_Medium
						default_format = "#T"
						align = left|nobaseline
					}

					icon = {
						visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue( 'aov_school_divination_level' ), '(CFixedPoint)1' )]"
						size = { 30 29 }
						texture = "gfx/interface/icons/aov_magic/levels_strip.dds"
						framesize = { 42 41 }
						frame = 1
						tooltip = "AOV_SCHOOL_LEVEL_TT"
					}
					icon = {
						visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue( 'aov_school_divination_level' ), '(CFixedPoint)2' )]"
						size = { 30 29 }
						texture = "gfx/interface/icons/aov_magic/levels_strip.dds"
						framesize = { 42 41 }
						frame = 2
						tooltip = "AOV_SCHOOL_LEVEL_TT"
					}
					icon = {
						visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue( 'aov_school_divination_level' ), '(CFixedPoint)3' )]"
						size = { 30 29 }
						texture = "gfx/interface/icons/aov_magic/levels_strip.dds"
						framesize = { 42 41 }
						frame = 3
						tooltip = "AOV_SCHOOL_LEVEL_TT"
					}

					expand = {}
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 8

					progressbar_standard = {
						size = { 200 14 }
