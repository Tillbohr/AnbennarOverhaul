# Anbennar Overhaul: a Lich's glowing eyes, imported once from Godherja: The Dying World (Workshop 2326030123,
# gh_male_eyes_glowing / gh_female_eyes_glowing) onto the game's eye meshes. The glow is Anbennar's portrait_eye
# shader's emission from the properties texture's red channel (Godherja's mask). Names prefixed aov_; edit by hand.

entity = {
	name = "aov_male_lich_eyes_glowing_1_blue_entity"
	pdxmesh = "male_eyes_mesh"

	game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = { 0.0 0.0 }
			}
		}
	}

	meshsettings = {
		name = "male_eyesShape"
		index = 0
		texture_diffuse = "aov_lich_eyes_glowing_1_blue_diffuse.dds"
		texture_normal = "aov_lich_eyes_glowing_1_normal.dds"
		texture_specular = "aov_lich_eyes_glowing_1_properties.dds"
		shader = "portrait_eye"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
}

