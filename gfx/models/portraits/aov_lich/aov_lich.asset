entity = {
	name = "aov_male_skeleton_head_runes_01_entity"
	pdxmesh = "aov_male_skeleton_head_runes_01_mesh"
	
	game_data = {
		portrait_entity_user_data = {
			portrait_accessory = {
				pattern_mask = "gfx/models/portraits/aov_lich/skeleton_head_pattern_01_masks.dds"	#Any 4-channel texture. Each channel will be used to mask a pattern from the variation object
				variation = "aov_lich_skull_runes"	#A "variation" object in gfx/portraits/accessory_variations/
			}
		}
	}
}

