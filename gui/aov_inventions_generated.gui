	# Tier 1 tab of the Inventions tab
	type aov_inventions_tier_1 = vbox {
		spacing = 10

		vbox = {
			name = "aov_inventions_t1_society"
			layoutpolicy_horizontal = expanding
			margin = { 12 10 }
			margin_bottom = 14
			spacing = 6

			background = {
				using = Background_Area_With_Header
			}

			text_single = {
				text = "AOV_INVENTIONS_SECTION_SOCIETY"
				using = Font_Type_Flavor
				using = Font_Size_Medium
				default_format = "#T"
				margin_bottom = 6
				align = center|nobaseline
			}

