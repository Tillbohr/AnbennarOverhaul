######################################################
############ ARTIFICERY RESEARCH POPUP ###############
######################################################
# Opened by the Research button in the Inventions tab (GUI variable aov_research_popup).

window = {
	name = "aov_artificery_research_window"
	parentanchor = center
	layer = top
	movable = no
	size = { 620 760 }

	using = Window_Background_Popup

	visible = "[And( GetVariableSystem.Exists( 'aov_research_popup' ), And( GetVariableSystem.Exists( 'aov_artificery_window' ), GetScriptedGui('aov_artificery_available').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
	}

	vbox = {
		using = Window_Margins
		spacing = 10

		header_pattern = {
			layoutpolicy_horizontal = expanding

			blockoverride "header_text"
			{
				text = "AOV_RESEARCH_POPUP_TITLE"
			}

			blockoverride "button_close"
			{
				onclick = "[GetVariableSystem.Clear( 'aov_research_popup' )]"
			}
		}

		# Brillites
		vbox = {
			layoutpolicy_horizontal = expanding
			margin = { 15 0 }
			spacing = 6

			text_single = {
				layoutpolicy_horizontal = expanding
				text = "AOV_SPONSOR_BRILLITES_HEADER"
				align = left|nobaseline
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				max_width = 580
				text = "AOV_SPONSOR_BRILLITES_DESC"
			}

			button_standard = {
				size = { 280 34 }
				text = "AOV_RESEARCH_START_BRILLITES"
				enabled = "[GetScriptedGui('aov_research_brillites_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				tooltip = "[GetScriptedGui('aov_research_brillites_sgui').BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[GetScriptedGui('aov_research_brillites_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[GetVariableSystem.Clear( 'aov_research_popup' )]"
			}
		}

		# Mechanists
		vbox = {
			layoutpolicy_horizontal = expanding
			margin = { 15 0 }
			spacing = 6

			text_single = {
				layoutpolicy_horizontal = expanding
				text = "AOV_SPONSOR_MECHANISTS_HEADER"
				align = left|nobaseline
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				max_width = 580
				text = "AOV_SPONSOR_MECHANISTS_DESC"
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 6

				button_standard = {
					size = { 180 34 }
					text = "AOV_FILTER_ECONOMIC"
					enabled = "[GetScriptedGui('aov_research_mechanists_economic_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "[GetScriptedGui('aov_research_mechanists_economic_sgui').BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[GetScriptedGui('aov_research_mechanists_economic_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[GetVariableSystem.Clear( 'aov_research_popup' )]"
				}

				button_standard = {
					size = { 180 34 }
					text = "AOV_FILTER_MILITARY"
					enabled = "[GetScriptedGui('aov_research_mechanists_military_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "[GetScriptedGui('aov_research_mechanists_military_sgui').BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[GetScriptedGui('aov_research_mechanists_military_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[GetVariableSystem.Clear( 'aov_research_popup' )]"
				}

				button_standard = {
					size = { 180 34 }
					text = "AOV_FILTER_SOCIETY"
					enabled = "[GetScriptedGui('aov_research_mechanists_society_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "[GetScriptedGui('aov_research_mechanists_society_sgui').BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[GetScriptedGui('aov_research_mechanists_society_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[GetVariableSystem.Clear( 'aov_research_popup' )]"
				}

				expand = {}
			}
		}

		# Technomancers
		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			margin = { 15 0 }
			spacing = 6

			text_single = {
				layoutpolicy_horizontal = expanding
				text = "AOV_SPONSOR_TECHNOMANCERS_HEADER"
				align = left|nobaseline
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				max_width = 580
				text = "AOV_SPONSOR_TECHNOMANCERS_DESC"
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 6

				button_standard = {
					size = { 180 34 }
					text = "AOV_FILTER_ECONOMIC"
					down = "[GetVariableSystem.HasValue( 'aov_research_tech_cat', 'economic' )]"
					enabled = "[GetScriptedGui('aov_research_technomancers_economic_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "[GetScriptedGui('aov_research_technomancers_economic_sgui').BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[GetScriptedGui('aov_research_technomancers_economic_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[GetVariableSystem.Set( 'aov_research_tech_cat', 'economic' )]"
				}

				button_standard = {
					size = { 180 34 }
					text = "AOV_FILTER_MILITARY"
					down = "[GetVariableSystem.HasValue( 'aov_research_tech_cat', 'military' )]"
					enabled = "[GetScriptedGui('aov_research_technomancers_military_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "[GetScriptedGui('aov_research_technomancers_military_sgui').BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[GetScriptedGui('aov_research_technomancers_military_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[GetVariableSystem.Set( 'aov_research_tech_cat', 'military' )]"
				}

				button_standard = {
					size = { 180 34 }
					text = "AOV_FILTER_SOCIETY"
					down = "[GetVariableSystem.HasValue( 'aov_research_tech_cat', 'society' )]"
					enabled = "[GetScriptedGui('aov_research_technomancers_society_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "[GetScriptedGui('aov_research_technomancers_society_sgui').BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[GetScriptedGui('aov_research_technomancers_society_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[GetVariableSystem.Set( 'aov_research_tech_cat', 'society' )]"
				}

				expand = {}
			}

			aov_inventions_offers_economic = {
				visible = "[GetVariableSystem.HasValue( 'aov_research_tech_cat', 'economic' )]"
				layoutpolicy_horizontal = expanding
			}

			aov_inventions_offers_military = {
				visible = "[GetVariableSystem.HasValue( 'aov_research_tech_cat', 'military' )]"
				layoutpolicy_horizontal = expanding
			}

			aov_inventions_offers_society = {
				visible = "[GetVariableSystem.HasValue( 'aov_research_tech_cat', 'society' )]"
				layoutpolicy_horizontal = expanding
			}

			expand = {}
		}
	}
}
