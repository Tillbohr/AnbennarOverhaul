######################################################
#################### MAGIC WINDOW ####################
######################################################
# Opened by the Magic main tab (gui/hud.gui, generated by tools/build_hud_override.py).
# Same frame as gui/aov_window_artificery.gui. School pages and spell cards: gui/aov_magic_generated.gui
# (generated by tools/build_spells.py). GUI variables: aov_magic_window (open), aov_magic_school (unset = Abjuration).

window = {
	name = "aov_magic_window"
	parentanchor = top|right
	layer = windows_layer
	movable = no

	using = Window_Size_MainTab

	visible = "[And( GetVariableSystem.Exists( 'aov_magic_window' ), And( GetScriptedGui('aov_magic_available').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), Not( IsRightWindowOpen ) ) )]"

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
		using = Window_Position_MainTab
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
		using = Window_Position_MainTab_Hide
	}

	margin_widget = {
		size = { 100% 100% }
		margin_right = 40

		using = Window_Background

		blockoverride "bg_margins"
		{
			margin_right = -35
			margin_left = -23
		}
	}

	margin_widget = {
		size = { 100% 100% }
		margin_top = 30
		margin_bottom = 25
		margin_right = 13

		widget = {
			size = { 100% 100% }

			vbox = {
				using = Window_Margins

				header_pattern = {
					layoutpolicy_horizontal = expanding

					blockoverride "header_text"
					{
						text = "AOV_MAGIC_WINDOW_TITLE"
					}

					blockoverride "button_close"
					{
						onclick = "[GetVariableSystem.Clear( 'aov_magic_window' )]"
					}
				}

				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin = { 10 10 }
					spacing = 8

					# Mana
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8

						text_single = {
							text = "AOV_MAGIC_MANA"
							tooltip = "AOV_MAGIC_MANA_TT"
							align = left|nobaseline
						}

						progressbar_standard = {
							layoutpolicy_horizontal = expanding
							size = { 0 16 }
							min = 0
							max = 100
							value = "[FixedPointToFloat( GetPlayer.MakeScope.ScriptValue( 'aov_mana_percent' ) )]"
							progresstexture = "gfx/interface/progressbars/progress_blue.dds"
							noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
							tooltip = "AOV_MAGIC_MANA_TT"
						}
					}

					# Study
					text_single = {
						layoutpolicy_horizontal = expanding
						text = "AOV_MAGIC_STUDYING"
						tooltip = "AOV_MAGIC_STUDY_TT"
						align = left|nobaseline
					}

					# Schools
					hbox = {
						name = "aov_magic_school_tabs"
						layoutpolicy_horizontal = expanding
						spacing = 4

						button_standard = {
							name = "aov_magic_tab_abjuration"
							size = { 56 44 }
							onclick = "[GetVariableSystem.Clear( 'aov_magic_school' )]"
							down = "[Not( GetVariableSystem.Exists( 'aov_magic_school' ) )]"
							tooltip = "AOV_SCHOOL_ABJURATION"

							icon = {
								parentanchor = center
								size = { 34 34 }
								texture = "gfx/interface/icons/aov_magic/school_abjuration.dds"
							}
						}

						button_standard = {
							name = "aov_magic_tab_conjuration"
							size = { 56 44 }
							onclick = "[GetVariableSystem.Set( 'aov_magic_school', 'conjuration' )]"
							down = "[GetVariableSystem.HasValue( 'aov_magic_school', 'conjuration' )]"
							tooltip = "AOV_SCHOOL_CONJURATION"

							icon = {
								parentanchor = center
								size = { 34 34 }
								texture = "gfx/interface/icons/aov_magic/school_conjuration.dds"
							}
						}

						button_standard = {
							name = "aov_magic_tab_divination"
							size = { 56 44 }
							onclick = "[GetVariableSystem.Set( 'aov_magic_school', 'divination' )]"
							down = "[GetVariableSystem.HasValue( 'aov_magic_school', 'divination' )]"
							tooltip = "AOV_SCHOOL_DIVINATION"

							icon = {
								parentanchor = center
								size = { 34 34 }
								texture = "gfx/interface/icons/aov_magic/school_divination.dds"
							}
						}

						button_standard = {
							name = "aov_magic_tab_enchantment"
							size = { 56 44 }
							onclick = "[GetVariableSystem.Set( 'aov_magic_school', 'enchantment' )]"
							down = "[GetVariableSystem.HasValue( 'aov_magic_school', 'enchantment' )]"
							tooltip = "AOV_SCHOOL_ENCHANTMENT"

							icon = {
								parentanchor = center
								size = { 34 34 }
								texture = "gfx/interface/icons/aov_magic/school_enchantment.dds"
							}
						}

						button_standard = {
							name = "aov_magic_tab_evocation"
							size = { 56 44 }
							onclick = "[GetVariableSystem.Set( 'aov_magic_school', 'evocation' )]"
							down = "[GetVariableSystem.HasValue( 'aov_magic_school', 'evocation' )]"
							tooltip = "AOV_SCHOOL_EVOCATION"

							icon = {
								parentanchor = center
								size = { 34 34 }
								texture = "gfx/interface/icons/aov_magic/school_evocation.dds"
							}
						}

						button_standard = {
							name = "aov_magic_tab_illusion"
							size = { 56 44 }
							onclick = "[GetVariableSystem.Set( 'aov_magic_school', 'illusion' )]"
							down = "[GetVariableSystem.HasValue( 'aov_magic_school', 'illusion' )]"
							tooltip = "AOV_SCHOOL_ILLUSION"

							icon = {
								parentanchor = center
								size = { 34 34 }
								texture = "gfx/interface/icons/aov_magic/school_illusion.dds"
							}
						}

						button_standard = {
							name = "aov_magic_tab_necromancy"
							size = { 56 44 }
							onclick = "[GetVariableSystem.Set( 'aov_magic_school', 'necromancy' )]"
							down = "[GetVariableSystem.HasValue( 'aov_magic_school', 'necromancy' )]"
							tooltip = "AOV_SCHOOL_NECROMANCY"

							icon = {
								parentanchor = center
								size = { 34 34 }
								texture = "gfx/interface/icons/aov_magic/school_necromancy.dds"
							}
						}

						button_standard = {
							name = "aov_magic_tab_transmutation"
							size = { 56 44 }
							onclick = "[GetVariableSystem.Set( 'aov_magic_school', 'transmutation' )]"
							down = "[GetVariableSystem.HasValue( 'aov_magic_school', 'transmutation' )]"
							tooltip = "AOV_SCHOOL_TRANSMUTATION"

							icon = {
								parentanchor = center
								size = { 34 34 }
								texture = "gfx/interface/icons/aov_magic/school_transmutation.dds"
							}
						}

						expand = {}
					}

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						blockoverride "scrollbox_content"
						{
							vbox = {
								layoutpolicy_horizontal = expanding
								margin = { 6 6 }

								aov_magic_school_abjuration = {
									visible = "[Not( GetVariableSystem.Exists( 'aov_magic_school' ) )]"
								}

								aov_magic_school_conjuration = {
									visible = "[GetVariableSystem.HasValue( 'aov_magic_school', 'conjuration' )]"
								}

								aov_magic_school_divination = {
									visible = "[GetVariableSystem.HasValue( 'aov_magic_school', 'divination' )]"
								}

								aov_magic_school_enchantment = {
									visible = "[GetVariableSystem.HasValue( 'aov_magic_school', 'enchantment' )]"
								}

								aov_magic_school_evocation = {
									visible = "[GetVariableSystem.HasValue( 'aov_magic_school', 'evocation' )]"
								}

								aov_magic_school_illusion = {
									visible = "[GetVariableSystem.HasValue( 'aov_magic_school', 'illusion' )]"
								}

								aov_magic_school_necromancy = {
									visible = "[GetVariableSystem.HasValue( 'aov_magic_school', 'necromancy' )]"
								}

								aov_magic_school_transmutation = {
									visible = "[GetVariableSystem.HasValue( 'aov_magic_school', 'transmutation' )]"
								}
							}
						}
					}
				}
			}
		}
	}
}
