					}

					text_single = {
						text = "AOV_SCHOOL_DIVINATION_PROGRESS"
						align = left|nobaseline
					}

					expand = {}
				}
			}

			button_standard = {
				size = { 140 32 }
				text = "[SelectLocalization( GetScriptedGui('aov_study_divination_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), 'AOV_STUDYING', 'AOV_STUDY_THIS_SCHOOL' )]"
