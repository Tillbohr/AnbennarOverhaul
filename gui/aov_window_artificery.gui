######################################################
################# ARTIFICERY WINDOW ##################
######################################################
# Opened by the Artificery main tab (gui/hud.gui, generated by tools/build_hud_override.py).
# Shown while the variable is set, the player passes can_use_artificery_trigger,
# and no vanilla main-tab window is open.

window = {
	name = "aov_artificery_window"
	parentanchor = top|right
	layer = windows_layer
	movable = no

	using = Window_Size_MainTab

	visible = "[And( GetVariableSystem.Exists( 'aov_artificery_window' ), And( GetScriptedGui('aov_artificery_available').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), Not( IsRightWindowOpen ) ) )]"

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
		using = Window_Position_MainTab
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
		using = Window_Position_MainTab_Hide
	}

	# Vanilla main-tab windows get this background from sidebar_background_right (hud_sidebars.gui),
	# which only shows while IsRightWindowOpen; this window is a scripted widget, so it draws its own
	margin_widget = {
		size = { 100% 100% }
		margin_right = 40

		using = Window_Background

		blockoverride "bg_margins"
		{
			margin_right = -35
			margin_left = -23
		}
	}

	margin_widget = {
		size = { 100% 100% }
		margin_top = 30
		margin_bottom = 25
		margin_right = 13

		widget = {
			size = { 100% 100% }

			vbox = {
				using = Window_Margins

				header_pattern = {
					layoutpolicy_horizontal = expanding

					blockoverride "header_text"
					{
						text = "AOV_ARTIFICERY_WINDOW_TITLE"
					}

					blockoverride "button_close"
					{
						onclick = "[GetVariableSystem.Clear( 'aov_artificery_window' )]"
					}
				}

				hbox = {
					name = "aov_artificery_tabs"
					layoutpolicy_horizontal = expanding

					button_tab = {
						name = "aov_artificery_tab_factions"
						onclick = "[GetVariableSystem.Clear( 'aov_artificery_tab' )]"
						down = "[Not( GetVariableSystem.Exists( 'aov_artificery_tab' ) )]"
						alwaystransparent = "[Not( GetVariableSystem.Exists( 'aov_artificery_tab' ) )]"

						blockoverride "tab_label"
						{
							text = "AOV_ARTIFICERY_TAB_FACTIONS"
							max_width = 220
						}
					}

					button_tab = {
						name = "aov_artificery_tab_inventions"
						onclick = "[GetVariableSystem.Set( 'aov_artificery_tab', 'inventions' )]"
						down = "[GetVariableSystem.HasValue( 'aov_artificery_tab', 'inventions' )]"
						alwaystransparent = "[GetVariableSystem.HasValue( 'aov_artificery_tab', 'inventions' )]"

						blockoverride "tab_label"
						{
							text = "AOV_ARTIFICERY_TAB_INVENTIONS"
							max_width = 220
						}
					}
				}

				# Factions tab: filled by the artificer factions spec
				vbox = {
					name = "aov_artificery_factions_body"
					visible = "[Not( GetVariableSystem.Exists( 'aov_artificery_tab' ) )]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin = { 10 10 }

					# One card per faction: gui/aov_artificer_factions.gui
					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						blockoverride "scrollbox_content"
						{
							vbox = {
								layoutpolicy_horizontal = expanding
								margin = { 6 6 }
								spacing = 12

								aov_faction_card = {
									blockoverride "title" {
										datacontext = "[GetTitleByKey('d_brillites')]"
									}
									blockoverride "faction_name" {
										text = "AOV_FACTION_NAME_BRILLITES"
									}
									blockoverride "vacant_text" {
										text = "[SelectLocalization( GetScriptedGui('aov_faction_brillites_election_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), 'AOV_FACTION_ELECTION_UNDER_WAY', 'AOV_FACTION_VACANT' )]"
									}
									blockoverride "description" {
										text = "AOV_FACTION_DESC_BRILLITES"
									}
									blockoverride "value" {
										value = "[FixedPointToFloat( GetPlayer.MakeScope.ScriptValue('aov_influence_brillites') )]"
									}
									blockoverride "bar_tooltip" {
										tooltip = "AOV_INFLUENCE_BRILLITES_TT"
									}
									blockoverride "marker_1_active" {
										visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_brillites'), '(CFixedPoint)1' )]"
									}
									blockoverride "marker_1_inactive" {
										visible = "[Not( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_brillites'), '(CFixedPoint)1' ) )]"
									}
									blockoverride "marker_1_tooltip" {
										tooltip = "AOV_LEVEL_DISPLEASED_BRILLITES_TT"
									}
									blockoverride "marker_2_active" {
										visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_brillites'), '(CFixedPoint)2' )]"
									}
									blockoverride "marker_2_inactive" {
										visible = "[Not( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_brillites'), '(CFixedPoint)2' ) )]"
									}
									blockoverride "marker_2_tooltip" {
										tooltip = "AOV_LEVEL_NEUTRAL_BRILLITES_TT"
									}
									blockoverride "marker_3_active" {
										visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_brillites'), '(CFixedPoint)3' )]"
									}
									blockoverride "marker_3_inactive" {
										visible = "[Not( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_brillites'), '(CFixedPoint)3' ) )]"
									}
									blockoverride "marker_3_tooltip" {
										tooltip = "AOV_LEVEL_FAVORED_BRILLITES_TT"
									}
									blockoverride "marker_4_active" {
										visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_brillites'), '(CFixedPoint)4' )]"
									}
									blockoverride "marker_4_inactive" {
										visible = "[Not( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_brillites'), '(CFixedPoint)4' ) )]"
									}
									blockoverride "marker_4_tooltip" {
										tooltip = "AOV_LEVEL_EXALTED_BRILLITES_TT"
									}
									blockoverride "status" {
										text = "AOV_FACTION_STATUS_BRILLITES"
									}
									blockoverride "amends" {
										enabled = "[GetScriptedGui('aov_make_amends_brillites_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
										tooltip = "[GetScriptedGui('aov_make_amends_brillites_sgui').BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
										onclick = "[GetScriptedGui('aov_make_amends_brillites_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
									}
								}

								aov_faction_card = {
									blockoverride "title" {
										datacontext = "[GetTitleByKey('d_mechanists')]"
									}
									blockoverride "faction_name" {
										text = "AOV_FACTION_NAME_MECHANISTS"
									}
									blockoverride "vacant_text" {
										text = "[SelectLocalization( GetScriptedGui('aov_faction_mechanists_election_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), 'AOV_FACTION_ELECTION_UNDER_WAY', 'AOV_FACTION_VACANT' )]"
									}
									blockoverride "description" {
										text = "AOV_FACTION_DESC_MECHANISTS"
									}
									blockoverride "value" {
										value = "[FixedPointToFloat( GetPlayer.MakeScope.ScriptValue('aov_influence_mechanists') )]"
									}
									blockoverride "bar_tooltip" {
										tooltip = "AOV_INFLUENCE_MECHANISTS_TT"
									}
									blockoverride "marker_1_active" {
										visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_mechanists'), '(CFixedPoint)1' )]"
									}
									blockoverride "marker_1_inactive" {
										visible = "[Not( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_mechanists'), '(CFixedPoint)1' ) )]"
									}
									blockoverride "marker_1_tooltip" {
										tooltip = "AOV_LEVEL_DISPLEASED_MECHANISTS_TT"
									}
									blockoverride "marker_2_active" {
										visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_mechanists'), '(CFixedPoint)2' )]"
									}
									blockoverride "marker_2_inactive" {
										visible = "[Not( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_mechanists'), '(CFixedPoint)2' ) )]"
									}
									blockoverride "marker_2_tooltip" {
										tooltip = "AOV_LEVEL_NEUTRAL_MECHANISTS_TT"
									}
									blockoverride "marker_3_active" {
										visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_mechanists'), '(CFixedPoint)3' )]"
									}
									blockoverride "marker_3_inactive" {
										visible = "[Not( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_mechanists'), '(CFixedPoint)3' ) )]"
									}
									blockoverride "marker_3_tooltip" {
										tooltip = "AOV_LEVEL_FAVORED_MECHANISTS_TT"
									}
									blockoverride "marker_4_active" {
										visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_mechanists'), '(CFixedPoint)4' )]"
									}
									blockoverride "marker_4_inactive" {
										visible = "[Not( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_mechanists'), '(CFixedPoint)4' ) )]"
									}
									blockoverride "marker_4_tooltip" {
										tooltip = "AOV_LEVEL_EXALTED_MECHANISTS_TT"
									}
									blockoverride "status" {
										text = "AOV_FACTION_STATUS_MECHANISTS"
									}
									blockoverride "amends" {
										enabled = "[GetScriptedGui('aov_make_amends_mechanists_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
										tooltip = "[GetScriptedGui('aov_make_amends_mechanists_sgui').BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
										onclick = "[GetScriptedGui('aov_make_amends_mechanists_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
									}
								}

								aov_faction_card = {
									blockoverride "title" {
										datacontext = "[GetTitleByKey('d_technomancers')]"
									}
									blockoverride "faction_name" {
										text = "AOV_FACTION_NAME_TECHNOMANCERS"
									}
									blockoverride "vacant_text" {
										text = "[SelectLocalization( GetScriptedGui('aov_faction_technomancers_election_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), 'AOV_FACTION_ELECTION_UNDER_WAY', 'AOV_FACTION_VACANT' )]"
									}
									blockoverride "description" {
										text = "AOV_FACTION_DESC_TECHNOMANCERS"
									}
									blockoverride "value" {
										value = "[FixedPointToFloat( GetPlayer.MakeScope.ScriptValue('aov_influence_technomancers') )]"
									}
									blockoverride "bar_tooltip" {
										tooltip = "AOV_INFLUENCE_TECHNOMANCERS_TT"
									}
									blockoverride "marker_1_active" {
										visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_technomancers'), '(CFixedPoint)1' )]"
									}
									blockoverride "marker_1_inactive" {
										visible = "[Not( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_technomancers'), '(CFixedPoint)1' ) )]"
									}
									blockoverride "marker_1_tooltip" {
										tooltip = "AOV_LEVEL_DISPLEASED_TECHNOMANCERS_TT"
									}
									blockoverride "marker_2_active" {
										visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_technomancers'), '(CFixedPoint)2' )]"
									}
									blockoverride "marker_2_inactive" {
										visible = "[Not( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_technomancers'), '(CFixedPoint)2' ) )]"
									}
									blockoverride "marker_2_tooltip" {
										tooltip = "AOV_LEVEL_NEUTRAL_TECHNOMANCERS_TT"
									}
									blockoverride "marker_3_active" {
										visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_technomancers'), '(CFixedPoint)3' )]"
									}
									blockoverride "marker_3_inactive" {
										visible = "[Not( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_technomancers'), '(CFixedPoint)3' ) )]"
									}
									blockoverride "marker_3_tooltip" {
										tooltip = "AOV_LEVEL_FAVORED_TECHNOMANCERS_TT"
									}
									blockoverride "marker_4_active" {
										visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_technomancers'), '(CFixedPoint)4' )]"
									}
									blockoverride "marker_4_inactive" {
										visible = "[Not( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('aov_influence_level_technomancers'), '(CFixedPoint)4' ) )]"
									}
									blockoverride "marker_4_tooltip" {
										tooltip = "AOV_LEVEL_EXALTED_TECHNOMANCERS_TT"
									}
									blockoverride "status" {
										text = "AOV_FACTION_STATUS_TECHNOMANCERS"
									}
									blockoverride "amends" {
										enabled = "[GetScriptedGui('aov_make_amends_technomancers_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
										tooltip = "[GetScriptedGui('aov_make_amends_technomancers_sgui').BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
										onclick = "[GetScriptedGui('aov_make_amends_technomancers_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
									}
								}
							}
						}
					}
				}

				# Inventions tab
				vbox = {
					name = "aov_artificery_inventions_body"
					visible = "[GetVariableSystem.HasValue( 'aov_artificery_tab', 'inventions' )]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin = { 10 10 }
					spacing = 8

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8

						text_single = {
							text = "AOV_INVENTIONS_SLOTS"
							tooltip = "AOV_INVENTIONS_SLOTS_TT"
							align = left|nobaseline
						}

						text_single = {
							visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue( 'aov_invention_slots_cooling' ), '(CFixedPoint)0' )]"
							text = "AOV_INVENTIONS_COOLING"
							align = left|nobaseline
						}

						expand = {}
					}

					# Research panel
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8

						vbox = {
							visible = "[GetScriptedGui('aov_research_running_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							layoutpolicy_horizontal = expanding

							text_single = {
								layoutpolicy_horizontal = expanding
								text = "AOV_RESEARCH_RUNNING"
								align = left|nobaseline
							}

							text_single = {
								visible = "[GetScriptedGui('aov_research_has_target_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								layoutpolicy_horizontal = expanding
								text = "AOV_RESEARCH_RUNNING_TARGET"
								align = left|nobaseline
							}

							text_single = {
								visible = "[GetScriptedGui('aov_research_has_category_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								layoutpolicy_horizontal = expanding
								text = "AOV_RESEARCH_RUNNING_CATEGORY"
								align = left|nobaseline
							}
						}

						expand = {
							visible = "[Not( GetScriptedGui('aov_research_running_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
						}

						button_standard = {
							visible = "[Not( GetScriptedGui('aov_research_running_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
							size = { 200 36 }
							text = "AOV_RESEARCH_BUTTON"
							enabled = "[GetScriptedGui('aov_research_can_start_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							tooltip = "[GetScriptedGui('aov_research_can_start_sgui').BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							onclick = "[GetVariableSystem.Clear( 'aov_research_stage' )]"
							onclick = "[GetVariableSystem.Clear( 'aov_research_faction' )]"
							onclick = "[GetVariableSystem.Clear( 'aov_research_hover' )]"
							onclick = "[GetVariableSystem.Set( 'aov_research_popup', 'open' )]"
						}
					}

					# Tier tabs, like EU4's inventions menu (variable aov_inventions_tier, unset = tier 1)
					hbox = {
						name = "aov_inventions_tier_tabs"
						layoutpolicy_horizontal = expanding

						button_tab = {
							name = "aov_inventions_tab_tier_1"
							onclick = "[GetVariableSystem.Clear( 'aov_inventions_tier' )]"
							down = "[Not( GetVariableSystem.Exists( 'aov_inventions_tier' ) )]"
							alwaystransparent = "[Not( GetVariableSystem.Exists( 'aov_inventions_tier' ) )]"
							tooltip = "AOV_INVENTIONS_TIER_1"

							blockoverride "tab_label"
							{
								text = "AOV_INVENTIONS_TAB_TIER_1"
								max_width = 180
							}
						}

						button_tab = {
							name = "aov_inventions_tab_tier_2"
							onclick = "[GetVariableSystem.Set( 'aov_inventions_tier', '2' )]"
							down = "[GetVariableSystem.HasValue( 'aov_inventions_tier', '2' )]"
							alwaystransparent = "[GetVariableSystem.HasValue( 'aov_inventions_tier', '2' )]"
							tooltip = "AOV_INVENTIONS_TIER_2"

							blockoverride "tab_label"
							{
								text = "AOV_INVENTIONS_TAB_TIER_2"
								max_width = 180
							}
						}

						button_tab = {
							name = "aov_inventions_tab_tier_3"
							onclick = "[GetVariableSystem.Set( 'aov_inventions_tier', '3' )]"
							down = "[GetVariableSystem.HasValue( 'aov_inventions_tier', '3' )]"
							alwaystransparent = "[GetVariableSystem.HasValue( 'aov_inventions_tier', '3' )]"
							tooltip = "AOV_INVENTIONS_TIER_3"

							blockoverride "tab_label"
							{
								text = "AOV_INVENTIONS_TAB_TIER_3"
								max_width = 180
							}
						}
					}

					text_single = {
						visible = "[And( GetVariableSystem.HasValue( 'aov_inventions_tier', '2' ), Not( GetScriptedGui('aov_inventions_tier_2_unlocked_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
						layoutpolicy_horizontal = expanding
						text = "AOV_INVENTIONS_TIER_LOCKED_2"
						align = center|nobaseline
					}

					text_single = {
						visible = "[And( GetVariableSystem.HasValue( 'aov_inventions_tier', '3' ), Not( GetScriptedGui('aov_inventions_tier_3_unlocked_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
						layoutpolicy_horizontal = expanding
						text = "AOV_INVENTIONS_TIER_LOCKED_3"
						align = center|nobaseline
					}

					# Society, Economic and Military boxes of the selected tier; click a box to activate or deactivate it
					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						blockoverride "scrollbox_content"
						{
							vbox = {
								layoutpolicy_horizontal = expanding
								margin = { 6 6 }

								aov_inventions_tier_1 = {
									visible = "[Not( GetVariableSystem.Exists( 'aov_inventions_tier' ) )]"
									layoutpolicy_horizontal = expanding
								}

								aov_inventions_tier_2 = {
									visible = "[GetVariableSystem.HasValue( 'aov_inventions_tier', '2' )]"
									layoutpolicy_horizontal = expanding
								}

								aov_inventions_tier_3 = {
									visible = "[GetVariableSystem.HasValue( 'aov_inventions_tier', '3' )]"
									layoutpolicy_horizontal = expanding
								}
							}
						}
					}
				}
			}
		}
	}
}
