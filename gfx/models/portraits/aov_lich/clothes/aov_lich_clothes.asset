pdxmesh = {
	name = "aov_robes_aversarian_liches_mesh"
	file = "robes_aversarian.mesh"
	
	blend_shape = { id = "robes_aversarian_old"					type = "robes_aversarian_old.mesh" }
	blend_shape = { id = "robes_aversarian_infant"				type = "robes_aversarian_infant.mesh" }
	blend_shape = { id = "robes_aversarian_fat"					type = "robes_aversarian_fat.mesh" }
	blend_shape = { id = "robes_aversarian_dwarf"				type = "robes_aversarian_dwarf.mesh" }
	blend_shape = { id = "robes_aversarian_gaunt"				type = "robes_aversarian_gaunt.mesh" }
	blend_shape = { id = "robes_aversarian_muscular"			type = "robes_aversarian_muscular.mesh" }

	meshsettings = {
		name = "robes_aversarian"
		index = 0
		texture_diffuse = "robes_aversarian_liches_color.dds"
		texture_normal = "robes_aversarian_normal.dds"
		texture_specular = "robes_aversarian_rough.dds"
		shader = "portrait_attachment_pattern_alpha_to_coverage"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
}

