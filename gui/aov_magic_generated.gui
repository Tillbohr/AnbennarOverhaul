	type aov_magic_school_illusion = vbox {
		layoutpolicy_horizontal = expanding
		spacing = 6

		hbox = {
			layoutpolicy_horizontal = expanding
			margin = { 6 4 }
			spacing = 10

			icon = {
				size = { 48 48 }
				texture = "gfx/interface/icons/aov_magic/school_illusion.dds"
			}

