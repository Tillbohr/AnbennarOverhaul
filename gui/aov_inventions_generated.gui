	# Tier 1 tab of the Inventions tab
	type aov_inventions_tier_1 = vbox {
		spacing = 10

		vbox = {
			name = "aov_inventions_t1_society"
			layoutpolicy_horizontal = expanding
			margin = { 12 10 }
			margin_bottom = 14
			spacing = 6

			background = {
				using = Background_Area_With_Header
			}

			text_single = {
				text = "AOV_INVENTIONS_SECTION_SOCIETY"
				using = Font_Type_Flavor
				using = Font_Size_Medium
				default_format = "#T"
				margin_bottom = 6
				align = center|nobaseline
			}

			hbox = {
				spacing = 6

				widget = {
					name = "aov_inv_box_centipedal_chests"
					visible = "[GetScriptedGui('aov_inv_centipedal_chests_visible_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					size = { 72 72 }

					button = {
						size = { 100% 100% }
						onclick = "[GetScriptedGui('aov_inv_centipedal_chests_toggle_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_icon_select"

						tooltipwidget = {
							aov_invention_centipedal_chests_tooltip = {}
						}

						# Locked or undiscovered
						highlight_icon = {
							visible = "[Not( Or( GetScriptedGui('aov_inv_centipedal_chests_activate_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), GetScriptedGui('aov_inv_centipedal_chests_deactivate_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
							size = { 100% 100% }
							texture = "gfx/interface/icons/aov_inventions/aov_invention_button_society.dds"
							framesize = { 78 78 }
							effectname = "GreyedOut"
							alpha = "[Select_float( GetScriptedGui('aov_inv_centipedal_chests_unlocked_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), '(float)1', '(float)0.45' )]"
							frame = 1
						}

						# Discovered
						highlight_icon = {
							visible = "[GetScriptedGui('aov_inv_centipedal_chests_activate_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							size = { 100% 100% }
							texture = "gfx/interface/icons/aov_inventions/aov_invention_button_society.dds"
							framesize = { 78 78 }
							frame = 2
						}

						# Active
						highlight_icon = {
							visible = "[GetScriptedGui('aov_inv_centipedal_chests_deactivate_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							size = { 100% 100% }
							texture = "gfx/interface/icons/aov_inventions/aov_invention_button_society.dds"
							framesize = { 78 78 }
							frame = 3
						}
					}
				}

				widget = {
					name = "aov_inv_box_conversation_calibrator"
					visible = "[GetScriptedGui('aov_inv_conversation_calibrator_visible_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					size = { 72 72 }

					button = {
						size = { 100% 100% }
						onclick = "[GetScriptedGui('aov_inv_conversation_calibrator_toggle_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_icon_select"

						tooltipwidget = {
							aov_invention_conversation_calibrator_tooltip = {}
						}

						# Locked or undiscovered
						highlight_icon = {
							visible = "[Not( Or( GetScriptedGui('aov_inv_conversation_calibrator_activate_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), GetScriptedGui('aov_inv_conversation_calibrator_deactivate_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
							size = { 100% 100% }
							texture = "gfx/interface/icons/aov_inventions/aov_invention_button_society.dds"
							framesize = { 78 78 }
							effectname = "GreyedOut"
							alpha = "[Select_float( GetScriptedGui('aov_inv_conversation_calibrator_unlocked_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), '(float)1', '(float)0.45' )]"
							frame = 1
						}

						# Discovered
						highlight_icon = {
							visible = "[GetScriptedGui('aov_inv_conversation_calibrator_activate_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							size = { 100% 100% }
							texture = "gfx/interface/icons/aov_inventions/aov_invention_button_society.dds"
